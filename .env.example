# LocalOS environment — copy to .env.local and fill in. NEVER commit real keys.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (database + auth + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; never expose to the client

# --- LLM routing (OpenRouter is the single key to all text models) ---
OPENROUTER_API_KEY=
# Optional direct providers for pinning high-volume routes (cheaper than router fee):
GOOGLE_GENERATIVE_AI_API_KEY=       # Gemini free tier
GROQ_API_KEY=                       # free tier, fast
DEEPSEEK_API_KEY=                   # very cheap
ANTHROPIC_API_KEY=                  # Claude Haiku for customer-facing replies
CEREBRAS_API_KEY=                   # 1M tokens/day free

# --- Media generation ---
FAL_KEY=                            # fal.ai — images (FLUX/Ideogram) + video (Luma/Wan)
# FFmpeg is a local binary for slideshow assembly (install separately; no key)

# --- Social publishing + analytics + reviews (add when reaching Phase 2/3) ---
AYRSHARE_API_KEY=

# --- Comms ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=                     # transactional + marketing email

# --- Voice (Phase 4 only) ---
DEEPGRAM_API_KEY=
BLAND_API_KEY=

# --- Payments (later) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
